# Supabase project settings → API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional credential-free demo; requires Vite dev and a loopback connection.
LOCAL_ADMIN_DEMO=false


# Server-only secret for sending client invitations. Set it in Netlify's secret environment variables.
# Never prefix it with PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Gemini API key for AI Coaching program selection. Leave empty to use rules-only matching.
# Set it in Netlify's secret environment variables. Never prefix it with PUBLIC_.
AI_API_KEY=
# Optional. Confirm the current Flash-Lite model ID before going live.
AI_MODEL=
